def truncated_lognormal(rng, size, median_um=30.0, sigma=0.3,
                        lower_um=20.0, upper_um=50.0):
    scale = median_um
    lo = lognorm.cdf(lower_um, s=sigma, scale=scale)
    hi = lognorm.cdf(upper_um, s=sigma, scale=scale)
    u = rng.uniform(lo, hi, size=size)
    return np.clip(lognorm.ppf(u, s=sigma, scale=scale), lower_um, upper_um)


def sample_polymer_density(rng, size, alpha=None):
    if alpha is None:
        alpha = POLYMER_ALPHA_UNIFORM
    w = rng.dirichlet(alpha, size=size)
    return w @ POLYMER_DENSITIES_G_CM3


def correlated_betas(rng, size, a1, b1, a2, b2, rho):
    if rho == 0:
        return rng.beta(a1, b1, size), rng.beta(a2, b2, size)
    z = rng.multivariate_normal([0, 0], [[1, rho], [rho, 1]], size=size)
    u = norm.cdf(z)
    return beta.ppf(u[:, 0], a1, b1), beta.ppf(u[:, 1], a2, b2)


def particle_count_from_mass(rng, size, mp_mass_ug_g, density_arr,
                             lower_um=20.0, upper_um=50.0):
    d_um = truncated_lognormal(rng, size, 30.0, 0.3, lower_um, upper_um)
    r_mm = (d_um / 1000.0) / 2.0
    v_mm3 = (4.0 / 3.0) * np.pi * r_mm ** 3
    mass_per_particle_g = v_mm3 * (density_arr / 1000.0)
    total_mass_g = mp_mass_ug_g * 1e-6 * RETINA_MASS_G
    return rng.poisson(lam=total_mass_g / mass_per_particle_g)


def simulate_competition(
    rng,
    size,
    mp_mass_ug_g,
    c_spatial_params,
    optical_params,
    hrf_lambda,
    non_mp_fraction,
    eyes_per_patient=2,
    overdispersion=0.3,
    rho=0.0,
    mixed_fraction=0.0,
    lower_um=20.0,
    upper_um=50.0,
):
    density_arr = sample_polymer_density(rng, size)
    particle_count = particle_count_from_mass(
        rng, size, mp_mass_ug_g, density_arr, lower_um, upper_um
    )

    c_sp, opt = correlated_betas(
        rng, size,
        c_spatial_params[0], c_spatial_params[1],
        optical_params[0], optical_params[1],
        rho,
    )
    potential_per_eye = particle_count * c_sp * opt
    potential_total = potential_per_eye * eyes_per_patient

    lambda_eff = np.full(size, float(hrf_lambda) * eyes_per_patient)
    if overdispersion > 0:
        b = rng.normal(0.0, overdispersion, size=size)
        lambda_eff = lambda_eff * np.exp(b)
    hrf_count = np.maximum(rng.poisson(lam=lambda_eff), 1)

    ceiling = 1.0 - non_mp_fraction
    supply_per_hrf = potential_total / hrf_count
    p_mp = np.clip(ceiling * (1.0 - np.exp(-supply_per_hrf)), 0.0, 1.0)

    mp_hrf = rng.binomial(hrf_count, p_mp)
    pct = 100.0 * mp_hrf / hrf_count
    has_any = (mp_hrf >= 1)

    mixed = rng.binomial(hrf_count - mp_hrf, mixed_fraction)
    pct_mixed = 100.0 * (mp_hrf + mixed) / hrf_count

    return {
        "percentage": pct,
        "percentage_including_mixed": pct_mixed,
        "has_any_mp": has_any,
        "mp_hrf": mp_hrf,
        "hrf_count": hrf_count,
        "particle_count": particle_count,
        "potential_mp_hrf": potential_total,
        "p_mp": p_mp,
    }


def summarize(name, out, extra=None):
    pct = np.asarray(out["percentage"])
    p_mp = np.asarray(out["p_mp"])
    has_any = np.asarray(out["has_any_mp"])
    hrf_count = np.asarray(out["hrf_count"])
    r = {
        "name": name,
        "n": int(pct.size),
        "median_pct": float(np.median(pct)),
        "mean_pct": float(np.mean(pct)),
        "std_pct": float(np.std(pct)),
        "pct_ci_lower": float(np.percentile(pct, 2.5)),
        "pct_ci_upper": float(np.percentile(pct, 97.5)),
        "mean_p_mp_pct": float(np.mean(p_mp) * 100.0),
        "p_mp_ci_lower_pct": float(np.percentile(p_mp, 2.5) * 100.0),
        "p_mp_ci_upper_pct": float(np.percentile(p_mp, 97.5) * 100.0),
        "pct_patients_with_any_mp": float(np.mean(has_any) * 100.0),
        "mean_hrf_count": float(np.mean(hrf_count)),
        "pct_over_10": float(np.mean(pct > 10.0) * 100.0),
        "pct_over_30": float(np.mean(pct > 30.0) * 100.0),
        "pct_over_50": float(np.mean(pct > 50.0) * 100.0),
    }
    if extra:
        r.update(extra)
    return r


