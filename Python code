# 9. Sample size
# ----------------------------------------------------------------------------
print("=" * 78)
print("SAMPLE SIZE CALCULATION")
print("=" * 78)


def n_for(conf, p):
    if p <= 0:
        return np.inf
    if p >= 1:
        return 1.0
    return float(np.log(1.0 - conf) / np.log(1.0 - p))


p_hrf_most_likely = float(np.mean(scenario_outputs["Most Likely"]["p_mp"]))
p_hrf_conservative = float(np.mean(scenario_outputs["Conservative"]["p_mp"]))
p_patient_most_likely = float(np.mean(scenario_outputs["Most Likely"]["has_any_mp"]))
p_patient_conservative = float(np.mean(scenario_outputs["Conservative"]["has_any_mp"]))

print(f"Per-HRF p(MP | HRF):  Most Likely = {p_hrf_most_likely:.4f}, "
      f"Conservative = {p_hrf_conservative:.4f}")
print(f"Per-patient P(>=1 MP-HRF): Most Likely = {p_patient_most_likely:.4f}, "
      f"Conservative = {p_patient_conservative:.4f}")
print()

sample_rows = []
for scen_label, p_hrf, p_pat in [
    ("Most Likely", p_hrf_most_likely, p_patient_most_likely),
    ("Conservative", p_hrf_conservative, p_patient_conservative),
]:
    for conf in [0.80, 0.90, 0.95]:
        n_hrf = n_for(conf, p_hrf)
        n_patient = n_for(conf, p_pat)
        sample_rows.append(dict(
            scenario=scen_label,
            confidence=conf,
            n_hrf=int(np.ceil(n_hrf)) if np.isfinite(n_hrf) else -1,
            raw_scan_equiv=n_hrf / HRF_PER_SCAN if np.isfinite(n_hrf) else -1,
            b_scans_ceiling=int(np.ceil(n_hrf / HRF_PER_SCAN)) if np.isfinite(n_hrf) else -1,
            n_patients=int(np.ceil(n_patient)) if np.isfinite(n_patient) else -1,
        ))
sample_df = pd.DataFrame(sample_rows)
sample_df.to_csv(OUTDIR / "sample_size_results.csv", index=False)
print(sample_df.round(3).to_string(index=False))
print()


