# 5. Polymer composition sensitivity
# ----------------------------------------------------------------------------
print("=" * 78)
print("POLYMER COMPOSITION SENSITIVITY")
print("=" * 78)

composition_priors = {
    "Uniform Dirichlet(1,1,1,1,1)": np.ones(5),
    "PS/PET-emphasised Dirichlet(3,1,3,1,2)": np.array([3, 1, 3, 1, 2]),
    "PE/PP-emphasised Dirichlet(1,3,1,3,2)": np.array([1, 3, 1, 3, 2]),
    "Fixed PS 1.05 g/cm3": "fixed",
}

comp_rows = []
for name, alpha in composition_priors.items():
    if isinstance(alpha, str) and alpha == "fixed":
        def sample_fixed(rng, size):
            return np.full(size, 1.05)
    else:
        def sample_fixed(rng, size, _a=alpha):
            w = rng.dirichlet(_a, size=size)
            return w @ POLYMER_DENSITIES_G_CM3

    original = sample_polymer_density
    globals()["sample_polymer_density"] = sample_fixed
    try:
        out = simulate_competition(RNG, N_SENSITIVITY, **BASE_DR)
        comp_rows.append(dict(
            prior=name,
            median=float(np.median(out["percentage"])),
            mean_p_mp_pct=float(np.mean(out["p_mp"]) * 100.0),
        ))
    finally:
        globals()["sample_polymer_density"] = original

comp_df = pd.DataFrame(comp_rows)
comp_df.to_csv(OUTDIR / "polymer_composition_sensitivity.csv", index=False)
print(comp_df.round(2).to_string(index=False))
