def run_scenario(iterations, scenario_name, mnp_mass_ug_g, c_spatial_params, optical_match_params, 
                 hrf_lambda=20, non_mnp_fraction=0.30):
    """Run scenario analysis with non-MNP baseline"""
    
    # Particle count
    particle_diameter_um = np.random.lognormal(mean=np.log(30), sigma=0.3, size=iterations)
    particle_volume_mm3 = (4/3) * np.pi * ((particle_diameter_um / 1000) / 2)**3
    mass_per_particle_g = particle_volume_mm3 * (1.05 / 1000)
    total_mnp_mass_g = mnp_mass_ug_g * 1e-6 * 0.25
    lambda_vector = total_mnp_mass_g / mass_per_particle_g
    particle_count = np.random.poisson(lam=lambda_vector)
    
    # Other parameters
    c_spatial = np.random.beta(a=c_spatial_params[0], b=c_spatial_params[1], size=iterations)
    optical_match = np.random.beta(a=optical_match_params[0], b=optical_match_params[1], size=iterations)
    
    # Potential MNP-HRF
    potential_mnp_hrf = particle_count * c_spatial * optical_match
    
    # HRF count
    hrf_count = np.random.poisson(lam=hrf_lambda, size=iterations)
    hrf_count = np.maximum(hrf_count, 1)
    
    # Calculate MNP-HRF with non-MNP baseline
    non_mnp_floor = non_mnp_fraction * hrf_count
    max_mnp_hrf = hrf_count - non_mnp_floor
    mnp_hrf = np.minimum(potential_mnp_hrf, max_mnp_hrf)
    mnp_hrf = np.maximum(mnp_hrf, 0)
    
    percentage = (mnp_hrf / hrf_count) * 100
    
    return {
        'scenario': scenario_name,
        'percentage': percentage,
        'median': np.median(percentage),
        'ci_lower': np.percentile(percentage, 2.5),
        'ci_upper': np.percentile(percentage, 97.5),
        'mean': np.mean(percentage),
        'std': np.std(percentage),
        'pct_nonzero': np.mean(percentage > 0) * 100,
        'pct_over_10': np.mean(percentage > 10) * 100,
        'pct_over_30': np.mean(percentage > 30) * 100,
        'pct_over_50': np.mean(percentage > 50) * 100
    }

# Scenario definitions
