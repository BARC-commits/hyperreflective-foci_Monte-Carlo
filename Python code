# MONTE CARLO SIMULATION: HRF ETIOLOGY AS COMPETITIVE PROCESS
# ============================================================================

# No random seed is set. Results will vary slightly between runs due to
# random sampling. See Appendix B for the exact output values from the
# simulation run used in this manuscript.

print("="*60)
print("MONTE CARLO SIMULATION")
print("(Modeling MNP-HRF competition with non-MNP HRF)")
print("="*60)
print("NOTE: No random seed is set. Results will vary slightly between runs.")
print("See Appendix B for the exact values from the simulation run used.")
print()

# Set to 1,000,000 iterations for base simulation
iterations = 1000000

print(f"Base Simulation Iterations: {iterations:,}")
print()

# 1. MNP Particle Count (from mass burden)
# Zhang et al. (2025) reported 49.21 μg/g in retinal tissue
particle_diameter_um = np.random.lognormal(mean=np.log(30), sigma=0.3, size=iterations)
particle_volume_mm3 = (4/3) * np.pi * ((particle_diameter_um / 1000) / 2)**3
particle_density_g_mm3 = 1.05 / 1000  # Polystyrene density
mass_per_particle_g = particle_volume_mm3 * particle_density_g_mm3
retina_mass_g = 0.25  # Approximate human retina mass
total_mnp_mass_g = 49.21e-6 * retina_mass_g
lambda_vector = total_mnp_mass_g / mass_per_particle_g
particle_count = np.random.poisson(lam=lambda_vector)

# 2. Spatial Congruence (C_spatial)
# Probability that a particle is positioned to form an HRF
# Beta(5,20) gives mean ~0.20, 95% range ~0.04-0.50
c_spatial = np.random.beta(a=5, b=20, size=iterations)

# 3. Optical Match Rate
# Probability that a positioned particle generates an HRF signal
# Beta(10,30) gives mean ~0.25, 95% range ~0.12-0.42
optical_match = np.random.beta(a=10, b=30, size=iterations)

# 4. Number of MNPs that could become HRF
potential_mnp_hrf = particle_count * c_spatial * optical_match

# 5. HRF Count (stratified by disease state)
hrf_count_healthy = np.random.poisson(lam=2, size=iterations)
hrf_count_dr = np.random.poisson(lam=20, size=iterations)
hrf_count_amd = np.random.poisson(lam=30, size=iterations)

# 6. Model HRF as "MNP-caused" vs "non-MNP-caused"
# A baseline percentage of HRF are assumed to be non-MNP
# (e.g., due to lipofuscin, macrophages, protein aggregates)
# This baseline varies by disease state

# Define baseline non-MNP HRF fraction (minimum % of HRF from other causes)
non_mnp_fraction = {
    'healthy': 0.70,  # At least 70% of HRF in healthy retina are non-MNP
    'dr': 0.30,       # At least 30% of HRF in DR are non-MNP
    'amd': 0.25       # At least 25% of HRF in AMD are non-MNP
}

def calculate_mnp_hrf(potential_mnp, hrf_count, non_mnp_fraction):
    """Calculate MNP-associated HRF with non-MNP baseline"""
    # Minimum number of non-MNP HRF (floor)
    non_mnp_floor = non_mnp_fraction * hrf_count
    
    # Maximum number of MNP-associated HRF (ceiling)
    max_mnp_hrf = hrf_count - non_mnp_floor
    
    # Actual MNP-associated HRF is the minimum of potential and ceiling
    mnp_hrf = np.minimum(potential_mnp, max_mnp_hrf)
    
    # Ensure non-negative
    mnp_hrf = np.maximum(mnp_hrf, 0)
    
    return mnp_hrf

# Calculate for each condition
mnp_hrf_healthy = calculate_mnp_hrf(potential_mnp_hrf, hrf_count_healthy, non_mnp_fraction['healthy'])
mnp_hrf_dr = calculate_mnp_hrf(potential_mnp_hrf, hrf_count_dr, non_mnp_fraction['dr'])
mnp_hrf_amd = calculate_mnp_hrf(potential_mnp_hrf, hrf_count_amd, non_mnp_fraction['amd'])

# 7. Calculate percentages
percentage_healthy = (mnp_hrf_healthy / np.maximum(hrf_count_healthy, 1)) * 100
percentage_dr = (mnp_hrf_dr / np.maximum(hrf_count_dr, 1)) * 100
percentage_amd = (mnp_hrf_amd / np.maximum(hrf_count_amd, 1)) * 100

# 8. Credible Intervals
ci_healthy = np.percentile(percentage_healthy, [2.5, 97.5])
ci_dr = np.percentile(percentage_dr, [2.5, 97.5])
ci_amd = np.percentile(percentage_amd, [2.5, 97.5])

