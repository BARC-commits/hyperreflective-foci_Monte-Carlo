print("SAMPLE SIZE CALCULATION (Using Most Likely Scenario)")
print("="*60)

# Most Likely Scenario (DR)
most_likely_median = 70.0
p_mnp_in_hrf = most_likely_median / 100

def samples_needed(p, confidence=0.95):
    if p <= 0 or p >= 1:
        return float('inf')
    return np.log(1 - confidence) / np.log(1 - p)

for confidence in [0.80, 0.90, 0.95]:
    n = samples_needed(p_mnp_in_hrf, confidence)
    if np.isfinite(n):
        print(f"To be {confidence*100:.0f}% confident of detecting at least one MNP-containing HRF:")
        print(f"  Need to sample approximately {int(np.ceil(n))} HRF")
        print(f"  (Equivalent to {int(np.ceil(n))/20:.1f} OCT B-scans with ~20 HRF each)")
    else:
        print(f"To be {confidence*100:.0f}% confident: Sample size calculation invalid (p={p_mnp_in_hrf:.2f})")

