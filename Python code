cluster_rows = []
for icc in [0.05, 0.10, 0.20]:
    for k in [5, 10, 20]:
        deff = 1.0 + (k - 1.0) * icc
        n_ind = n_for(0.95, p_hrf_most_likely)
        cluster_rows.append(dict(
            icc=icc,
            hrf_per_cluster=k,
            design_effect=deff,
            n_hrf_independent_95pct=int(np.ceil(n_ind)),
            n_hrf_adjusted_95pct=int(np.ceil(n_ind * deff)),
        ))
